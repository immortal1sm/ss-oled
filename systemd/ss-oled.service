[Unit]
Description=ss-oled — Apex Pro OLED heads-up display daemon
# The keyboard is plugged into the monitor's USB hub, so on a boot without the
# monitor it does not enumerate until later -- or not at all. `After=` on the
# device units makes systemd wait for the keyboard to be recognised before
# starting us, so the daemon never registers grabs against a keyboard the
# compositor cannot see yet.
After=graphical-session.target systemd-logind.service
Wants=systemd-logind.service

[Service]
Type=simple
# Inherit DBus session bus and runtime dir from the graphical session so
# MPRIS works under Wayland.
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus
Environment=XDG_RUNTIME_DIR=%t
# Binary is still `apex-tux`: the Cargo package name is unchanged (crate
# rename is deferred). The unit is `ss-oled` because that is the app identity.
ExecStart=%h/projects/apex-tux/target/release/ss-oled
WorkingDirectory=%h/.config/ss-oled
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
